---
import { Coffee, Globe } from '@lucide/astro';
import { NAV_LINKS, SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t-4 border-border bg-stark-black text-pure-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.4fr_1.1fr_0.9fr] md:gap-12">
      <!-- Column 1: Brand & Mission -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <p class="font-sans text-3xl font-black uppercase tracking-tighter text-pure-white">{SITE.name}</p>
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="size-3 rounded-full bg-bauhaus-red inline-block"></span>
            <span class="size-3 bg-bauhaus-blue inline-block"></span>
            <span class="size-3 bg-bauhaus-yellow inline-block [clip-path:polygon(50%_0%,0%_100%,100%_100%)]"></span>
          </div>
        </div>
        <p class="max-w-sm text-sm font-medium leading-relaxed text-[#A3A3A3]" data-i18n="footer.mission">
          Guía arquitectónica constructivista del Centro Histórico de San Salvador: monumentos, recorridos a pie y gastronomía local.
        </p>
        <p class="text-xs font-semibold text-[#A3A3A3]">
          Made with <span aria-label="love">❤️</span> by{' '}
          <a
            href={SITE.author.url}
            target="_blank"
            rel="noopener noreferrer"
            class="font-black text-pure-white underline underline-offset-4 decoration-bauhaus-red hover:text-bauhaus-yellow transition-colors"
          >
            {SITE.author.name}
          </a>
        </p>
      </div>

      <!-- Column 2: Author Credits & Support -->
      <div class="space-y-4">
        <p class="text-xs font-black uppercase tracking-widest text-bauhaus-yellow" data-i18n="footer.authorSupport">
          Autor & Apoyo
        </p>
        <ul class="space-y-2.5">
          <li>
            <a
              href={SITE.author.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-bold tracking-wide text-pure-white hover:text-bauhaus-yellow transition-colors"
            >
              <Globe class="size-4 text-bauhaus-blue" aria-hidden="true" />
              <span>arcelabs.com</span>
            </a>
          </li>
          <li>
            <a
              href={SITE.author.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-bold tracking-wide text-pure-white hover:text-bauhaus-yellow transition-colors"
            >
              <svg class="size-4 fill-current text-[#F0F0F0]" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>github.com/KevinArce</span>
            </a>
          </li>
        </ul>

        <div>
          <a
            href={SITE.author.buymeacoffee}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-pure-white bg-bauhaus-yellow px-3.5 py-2 font-mono text-xs font-black uppercase tracking-wider text-stark-black shadow-[3px_3px_0px_0px_#FFFFFF] hover:bg-pure-white active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all"
            aria-label="Apoyar el proyecto en Buy Me a Coffee"
            data-i18n-attr="aria-label:footer.coffeeAria"
          >
            <Coffee class="size-4 text-stark-black" aria-hidden="true" />
            <span data-i18n="footer.coffee">Invítame un café</span>
          </a>
        </div>
      </div>

      <!-- Column 3: Navigation -->
      <nav aria-label="Enlaces del pie de página" data-i18n-attr="aria-label:footer.navAria" class="md:text-right">
        <p class="mb-4 text-xs font-black uppercase tracking-widest text-bauhaus-yellow" data-i18n="footer.navTitle">
          Navegación
        </p>
        <ul class="flex flex-col gap-2.5 md:items-end">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-i18n={link.i18nKey}
                  class="text-sm font-bold uppercase tracking-wider text-pure-white transition-colors hover:text-bauhaus-yellow"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="pt-2 border-t border-[#333333] w-full md:w-auto">
            <a
              href="/llms.txt"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-mono text-xs font-black uppercase tracking-wider text-bauhaus-yellow hover:text-pure-white transition-colors"
            >
              <span class="size-1.5 rounded-full bg-bauhaus-yellow" aria-hidden="true"></span>
              <span data-i18n="footer.aiAgents">Agentes & IA (llms.txt)</span>
            </a>
          </li>
          <li>
            <a
              href="/api/all.json"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-mono text-xs font-bold uppercase tracking-wider text-[#A3A3A3] hover:text-pure-white transition-colors"
            >
              <span data-i18n="footer.openData">Datos Abiertos (JSON)</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t-2 border-[#333333] pt-6 sm:flex-row">
      <div class="flex items-center gap-2" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-bauhaus-red inline-block"></span>
        <span class="size-2.5 bg-bauhaus-blue inline-block"></span>
        <span class="size-2.5 bg-bauhaus-yellow inline-block [clip-path:polygon(50%_0%,0%_100%,100%_100%)]"></span>
      </div>

      <p class="text-xs font-medium text-[#A3A3A3] text-center sm:text-right">
        <span data-i18n="footer.copyright" data-i18n-params={JSON.stringify({ year, author: SITE.author.name })}>
          © {year} {SITE.name}. Creado por <a href={SITE.author.url} target="_blank" rel="noopener noreferrer" class="font-bold text-pure-white underline underline-offset-2 decoration-bauhaus-red hover:text-bauhaus-yellow transition-colors">{SITE.author.name}</a>. Código abierto bajo licencia MIT.
        </span>
      </p>
    </div>
  </div>
</footer>
